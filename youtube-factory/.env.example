# ─────────────────────────────────────────────────────────────────────────────
# YouTube Content Factory — environment
#
# Copy to .env and fill in what you have. Nothing here is required to boot: a
# provider without credentials reports itself unconfigured and the factory routes
# around it. Set OFFLINE_MODE=true to run the whole pipeline on mock providers
# with no network and no spend.
#
# Variable names follow each vendor's own documentation — HF_CREDENTIALS is what
# the Higgsfield SDK reads, ELEVENLABS_API_KEY is what ElevenLabs documents, and
# so on. Do not rename them.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
LOG_LEVEL=info
PORT=4000
HOST=0.0.0.0

# The origin the browser loads the dashboard from, and the origin it calls the API on.
# These must match what you actually type: mixing localhost and 127.0.0.1 between the
# two makes them different sites and the session cookie will be dropped.
PUBLIC_APP_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:4000

# ── data ─────────────────────────────────────────────────────────────────────
# Omit DATABASE_URL outside production to run against in-memory repositories.
DATABASE_URL=postgresql://factory:factory@localhost:5432/factory
REDIS_URL=redis://localhost:6379

# ── security (required in production) ────────────────────────────────────────
# 32 bytes as 64 hex characters. Generate one with: npm run factory --workspace @ycf/server -- keygen
ENCRYPTION_KEY=
WEBHOOK_SECRET=
SESSION_COOKIE_NAME=ycf_session
SESSION_TTL_DAYS=30
ALLOW_REGISTRATION=true

# ── object storage ───────────────────────────────────────────────────────────
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./.storage
# S3-compatible (AWS S3, MinIO, R2, Spaces). Set STORAGE_DRIVER=s3 to use it.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=factory
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_BASE_URL=

# ── queue ────────────────────────────────────────────────────────────────────
QUEUE_DRIVER=bullmq
QUEUE_CONCURRENCY=4

# ── Anthropic (https://api.anthropic.com/v1/messages) ────────────────────────
# Either name works; ANTHROPIC_API_KEY is the one Anthropic's own SDK reads.
ANTHROPIC_API_KEY=
# CLAUDE_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-sonnet-4-5
ANTHROPIC_FAST_MODEL=claude-haiku-4-5

# ── OpenAI (fallback text provider + images) ─────────────────────────────────
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com
OPENAI_MODEL=gpt-4.1
OPENAI_IMAGE_MODEL=gpt-image-1

# ── Higgsfield (https://platform.higgsfield.ai) ──────────────────────────────
# The SDK reads either the combined credential or the split pair.
HF_CREDENTIALS=KEY_ID:KEY_SECRET
# HF_API_KEY=
# HF_API_SECRET=
HIGGSFIELD_BASE_URL=https://platform.higgsfield.ai
HIGGSFIELD_VIDEO_MODEL=dop-turbo
# Optional callback so long generations do not have to be polled.
HIGGSFIELD_WEBHOOK_URL=

# ── ElevenLabs ───────────────────────────────────────────────────────────────
ELEVENLABS_API_KEY=
ELEVENLABS_BASE_URL=https://api.elevenlabs.io
ELEVENLABS_MODEL=eleven_multilingual_v2
ELEVENLABS_DEFAULT_VOICE_ID=

# ── YouTube (OAuth 2.0 + Data API v3) ────────────────────────────────────────
# Create an OAuth client of type "Web application" in Google Cloud Console and add
# YOUTUBE_REDIRECT_URI to its authorised redirect URIs.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:4000/api/channels/oauth/callback
# An API key is only needed for public/competitor lookups, which use no user token.
YOUTUBE_API_KEY=

# ── discovery sources (all optional) ─────────────────────────────────────────
NEWS_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=youtube-content-factory/1.0

# ── notifications (all optional) ─────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
DISCORD_WEBHOOK_URL=
SLACK_WEBHOOK_URL=
# POST-able relay that accepts { from, to, subject, text }.
SMTP_URL=
NOTIFY_FROM_EMAIL=factory@localhost

# ── media ────────────────────────────────────────────────────────────────────
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
RENDER_WIDTH=1920
RENDER_HEIGHT=1080
RENDER_FPS=30
RENDER_CRF=20
RENDER_PRESET=medium
MEDIA_WORK_DIR=./.work
MAX_CONCURRENT_RENDERS=1

# ── guardrails ───────────────────────────────────────────────────────────────
DEFAULT_MONTHLY_BUDGET_USD=100
PROVIDER_TIMEOUT_MS=120000
PROVIDER_MAX_ATTEMPTS=3

# Forces every provider to its mock: no network, no spend, full pipeline.
OFFLINE_MODE=false
