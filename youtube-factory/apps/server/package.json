{
  "name": "@ycf/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/main/api.js",
  "scripts": {
    "dev": "tsx watch src/main/api.ts",
    "dev:worker": "tsx watch src/main/worker.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main/api.js",
    "start:worker": "node dist/main/worker.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:dev": "prisma migrate dev",
    "seed": "tsx src/cli/index.ts seed",
    "factory": "tsx src/cli/index.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.699.0",
    "@aws-sdk/lib-storage": "^3.1129.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.1",
    "@fastify/rate-limit": "^10.2.1",
    "@prisma/client": "^6.1.0",
    "bullmq": "^5.34.0",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.0",
    "ioredis": "^5.4.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "prisma": "^6.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
