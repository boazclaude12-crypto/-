# --- Core ---
# 32+ char secret used to sign session cookies. Generate: openssl rand -hex 32
AUTH_SECRET=change-me-to-a-long-random-value-at-least-32-chars
# SQLite database file (relative paths resolve from the app root)
DATABASE_FILE=./data/recruiter.db
# Directory where uploaded CVs are stored (kept outside /public on purpose)
UPLOAD_DIR=./data/uploads

# --- AI provider ---
# local  = deterministic built-in engine, no external calls (default, always works)
# anthropic = use the Claude API for parsing/messages/chat (requires ANTHROPIC_API_KEY)
AI_PROVIDER=local
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# --- Outbound channels (not connected yet; mock transport is used when unset) ---
WHATSAPP_PROVIDER=mock
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
EMAIL_PROVIDER=mock
EMAIL_API_URL=
EMAIL_API_TOKEN=
EMAIL_FROM=
SMS_PROVIDER=mock
CALENDAR_PROVIDER=mock
