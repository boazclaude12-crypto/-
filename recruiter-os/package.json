{
  "name": "recruiter-os",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node --experimental-strip-types --import ./scripts/register.mjs scripts/migrate.ts",
    "db:seed": "node --experimental-strip-types --import ./scripts/register.mjs scripts/seed.ts",
    "db:reset": "node --experimental-strip-types --import ./scripts/register.mjs scripts/reset.ts",
    "test": "node --experimental-strip-types --import ./scripts/register.mjs --test tests/*.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "next": "^15.5.23",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "server-only": "^0.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3"
  }
}
