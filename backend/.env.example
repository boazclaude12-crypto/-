# Copy this file to .env.local and fill in your values.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OpenAI
NET_PUBLIC_SITE_URL_OPENAI_API_KEY=sk-...
NEXT_PUBLIC_SITE_OPENAI_ASSISTANT_ID=asst_...

# Site URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL_PAYMENT_SUCCESS=http://localhost:3000/payment-success
NEXT_PUBLIC_SITE_URL_PAYMENT_FAILD=http://localhost:3000/payment-failed

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Cardcom (Israeli payment)
NEXT_PUBLIC_CARDOM_TERMINAL_NUMBER=
NEXT_PUBLIC_CARDOM_API_NAME=
NEXT_PUBLIC_CARDOM_API_PASSWORD=

# Google OAuth
GOOGLE_AUTH_CLIENT_ID=
GOOGLE_AUTH_CLIENT_SECRET=

# Solana (wallet features)
HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=your-key

# Facebook Pixel
NEXT_PUBLIC_FB_PIXEL_ID=
FB_ACCESS_TOKEN=

# Admin
NEXT_PUBLIC_ADMIN_PASSWORD=changeme
NEXT_PUBLIC_CANCEL_ALLOWED=true
